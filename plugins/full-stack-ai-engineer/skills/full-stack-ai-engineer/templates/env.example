# Copy to .env and fill in real values. Never commit .env.
# Each variable is tagged [required] or [optional] so scripts/validate_project.py can check it.
# Values below are placeholders only.

# --- App ---
APP_ENV=development            # [required] development | staging | production
APP_PORT=8000                  # [optional] default 8000
LOG_LEVEL=info                 # [optional] debug | info | warning | error
ALLOWED_ORIGINS=http://localhost:3000   # [required] comma-separated; never "*" in production

# --- LLM provider ---
LLM_API_KEY=replace-me                  # [required] secret
LLM_MODEL=replace-with-model-name       # [required] pin an explicit model id
LLM_TIMEOUT_SECONDS=60                  # [optional]
LLM_MAX_OUTPUT_TOKENS=1024              # [optional] cap cost per request
MAX_AGENT_STEPS=10                      # [optional] agent loop budget
DAILY_SPEND_LIMIT_USD=20                # [optional] enforce in code and at the provider

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/appdb   # [required] secret

# --- Cache / queue ---
REDIS_URL=redis://localhost:6379/0      # [optional] required if queues or caching are enabled

# --- Auth ---
AUTH_SECRET=replace-with-long-random-string   # [required] secret, 32+ random bytes
SESSION_TTL_HOURS=24                           # [optional]

# --- Storage ---
S3_BUCKET=replace-me                    # [optional] required if file uploads are enabled
S3_ENDPOINT=                            # [optional] set for S3-compatible providers
S3_ACCESS_KEY_ID=replace-me             # [optional] secret
S3_SECRET_ACCESS_KEY=replace-me         # [optional] secret

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=            # [optional]
LANGFUSE_PUBLIC_KEY=                    # [optional]
LANGFUSE_SECRET_KEY=                    # [optional] secret
